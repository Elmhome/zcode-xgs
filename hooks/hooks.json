{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "/bin/bash",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/run.sh"
            ],
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
